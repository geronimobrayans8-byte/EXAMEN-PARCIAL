import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline

# --- 1. DATOS DEL EXPERIMENTO ---
f = np.array([100, 120, 145, 170, 200, 235, 270, 310, 355, 405, 
              460, 520, 585, 655, 730, 810, 895, 985, 1080, 1180, 
              1290, 1410, 1540, 1680, 1830, 1990, 2160, 2340, 2530, 2730])
Z = np.array([152.3, 149.1, 146.8, 144.9, 142.0, 139.5, 137.9, 136.1, 134.8, 133.6, 
              132.7, 131.9, 131.4, 131.1, 130.9, 131.0, 131.3, 131.9, 132.7, 133.8, 
              135.2, 136.9, 138.9, 141.1, 143.5, 146.1, 149.0, 152.2, 155.6, 159.2])

# Umbral de impedancia
Z_th = 150.0

# --- 2. CONSTRUCCIÓN DEL SPLINE Y FUNCIÓN OBJETIVO ---
spline = CubicSpline(f, Z, bc_type='natural')
spline_der = spline.derivative(1)

# Función objetivo: g(f) = |Z|(f) - Z_th = 0
def g(x):
    return spline(x) - Z_th

def g_prime(x):
    return spline_der(x)

# --- 3. MÉTODOS DE BÚSQUEDA DE RAÍCES ---

# 3.1. Método de Bisección
def bisection(func, a, b, tol=1e-6, max_iter=100):
    if func(a) * func(b) > 0:
        return None, 0
    iter_count = 0
    while (b - a) / 2.0 > tol and iter_count < max_iter:
        c = (a + b) / 2.0
        if func(c) == 0:
            break
        elif func(a) * func(c) < 0:
            b = c
        else:
            a = c
        iter_count += 1
    return (a + b) / 2.0, iter_count

# 3.2. Método de Newton-Raphson
def newton_raphson(func, dfunc, x0, tol=1e-6, max_iter=100):
    x = x0
    iter_count = 0
    for _ in range(max_iter):
        fx = func(x)
        dfx = dfunc(x)
        if abs(fx) < tol:
            break
        if dfx == 0:
            print("Derivada cero, falla Newton-Raphson")
            break
        x = x - fx / dfx
        iter_count += 1
    return x, iter_count

# --- 4. EJECUCIÓN Y COMPARACIÓN ---
# Intervalos iniciales y estimaciones (observando los datos)
# Raíz 1: entre 100 Hz y 120 Hz
r1_bis, iter1_bis = bisection(g, 100, 120)
r1_nr, iter1_nr = newton_raphson(g, g_prime, 110)

# Raíz 2: entre 2160 Hz y 2340 Hz (cercana a 2000 Hz)
r2_bis, iter2_bis = bisection(g, 2160, 2340)
r2_nr, iter2_nr = newton_raphson(g, g_prime, 2200)

# --- 5. SENSIBILIDAD ---
# df/dZ = 1 / (dZ/df)
derivada_Z_f = spline_der(r2_nr)
sensibilidad = 1 / derivada_Z_f

# --- 6. GRÁFICO DE LA BANDA DE OPERACIÓN SEGURA ---
f_malla = np.linspace(min(f), max(f), 1000)
Z_malla = spline(f_malla)

plt.figure(figsize=(10, 6))
plt.plot(f, Z, 'ko', label='Datos', zorder=3)
plt.plot(f_malla, Z_malla, 'b-', label='Spline Cúbico', zorder=2)
plt.axhline(Z_th, color='red', linestyle='--', label=f'Umbral Z_th = {Z_th} $\Omega$', zorder=1)

# Marcar las raíces
plt.plot(r1_nr, Z_th, 'gs', markersize=8, label=f'Límite inferior: {r1_nr:.4f} Hz')
plt.plot(r2_nr, Z_th, 'ms', markersize=8, label=f'Límite superior: {r2_nr:.4f} Hz')

# Sombrear la banda segura
plt.fill_between(f_malla, Z_malla, Z_th, where=(Z_malla <= Z_th), color='green', alpha=0.2, label='Banda de Operación Segura')

plt.title('Búsqueda de Raíces: Límites de Operación Segura', fontsize=14)
plt.xlabel('Frecuencia f (Hz)', fontsize=12)
plt.ylabel('Impedancia |Z| ($\Omega$)', fontsize=12)
plt.grid(True, linestyle='--', alpha=0.7)
plt.legend(fontsize=10, loc='upper right')
plt.show()

# --- 7. IMPRESIÓN DE RESULTADOS ---
print("--- RESULTADOS NUMÉRICOS (4 DECIMALES) ---")
print(f"Raíz 1 (Límite Inferior):")
print(f"  - Bisección:      {r1_bis:.4f} Hz (en {iter1_bis} iteraciones)")
print(f"  - Newton-Raphson: {r1_nr:.4f} Hz (en {iter1_nr} iteraciones)")

print(f"\nRaíz 2 (Límite Superior, cercana a 2000 Hz):")
print(f"  - Bisección:      {r2_bis:.4f} Hz (en {iter2_bis} iteraciones)")
print(f"  - Newton-Raphson: {r2_nr:.4f} Hz (en {iter2_nr} iteraciones)")

print(f"\nAnálisis de Sensibilidad en la Raíz 2 ({r2_nr:.4f} Hz):")
print(f"  - Derivada d|Z|/df: {derivada_Z_f:.4f} Ohmios/Hz")
print(f"  - Sensibilidad df/dZ: {sensibilidad:.4f} Hz/Ohmio")
